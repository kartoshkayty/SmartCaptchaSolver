{
  "name": "SmartCaptchaSolver",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf ./dist",
    "assets": "copyfiles -u 1 src/**/*.html dist",
    "build": "pnpm run clean && tsc -b && pnpm run assets",
    "start": "pnpm run build && node .",
    "watch": "nodemon",
    "proto:gen": "grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/protocol --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,useExactTypes=false --proto_path=./proto ./proto/captcha.proto"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "grpc-tools": "^1.13.1",
    "ts-proto": "^2.11.8"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@types/dns-packet": "^5.6.5",
    "express": "^5.2.1",
    "long": "^5.3.2",
    "nice-grpc": "^2.1.16",
    "nice-grpc-common": "^2.0.3",
    "patchright": "^1.60.2",
    "protobufjs": "^8.6.3",
    "ws": "^8.21.0"
  }
}
