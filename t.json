{
  "log": {
    "disabled": false,
    "level": "debug"
  },
  "dns": {},
  "inbounds": [
    {
      "type": "redirect",
      "tag": "redirect-in",
      "listen": "127.0.0.1",
      "listen_port": 4025
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "redirect-in",
