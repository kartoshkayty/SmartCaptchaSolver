      },
      {
        "inbound": ["redirect-in"],
        "network": "tcp",
        "protocol": ["tls", "http", "quic"],
        "ip_cidr": ["10.0.0.0/24", "192.168.0.0/16", "127.0.0.1/32"],
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "inbound": ["redirect-in"],
        "network": "tcp",
        "protocol": ["tls", "http", "quic"],
        "action": "route",
        "outbound": "auto-outbound"
      }
    ]
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out"
    },
